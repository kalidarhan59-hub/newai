# Copy to backend/.env and fill in any subset of these keys.
# Manus Core falls back to the deterministic Mock provider when keys are missing.

# AI providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=

# Tools
TAVILY_API_KEY=
SERPER_API_KEY=
ELEVENLABS_API_KEY=

# Storage
DATA_DIR=./data

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
